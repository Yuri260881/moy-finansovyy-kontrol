VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
# Repository variable for GitHub Pages subpath, e.g. /my-finance/
GITHUB_PAGES_BASE=/my-finance/
# Supabase Edge Function secrets (set with supabase secrets set; NEVER use VITE_):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/google-oauth/callback
# APP_ORIGIN=https://USERNAME.github.io
# APP_BASE_PATH=/my-finance/
# TELEGRAM_BOT_TOKEN=
# MAIL_PROVIDER_API_KEY= (optional Resend API key)
# MAIL_FROM= (verified sender)
# CRON_SECRET= (long random string)
